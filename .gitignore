# Rust / Cargo
# Build products
/target/

# rustfmt backup
**/*.rs.bk

# Local cargo Cache
/vendor/

# Cargo.lock Note
# Cargo.lock must submit.
#
# AICore is a workspace with multiple[[bin]:
#   - aicored
#   - aicore
#   - aicore-dashboard
#   - aicore-dashboard-web
#   - aicore-bench
#   - aicore-l0-realworld
#   - plugin-echo
#
# In the case of binary projects, Cargo officially recommended for submission to Cargo.lock to lock on the dependent version.
# Ensure that all environments (local / CI/ release) use exactly the same dependencies.

# Build / Release
/dist/

# Pack a temporary directory
*.deb
*.tar.gz
*.tar.xz
*.rpm
*.msi

# aicored Runtime Status File
*.log
*.status.json
*.json.tmp

# SQLite database and WAL
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Local benchmark output
/benchmarks/*-local.json
/benchmarks/*-nightly.json

# Test Temporary Directory
/tmp-test/

# Emacs
*~
\#*\#
.\#*

# Sublime
*.sublime-workspace
*.sublime-project

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# Personal path
/mydoc
/env