[Unit]
Description=AICore Daemon — AI Computer Control Layer
Documentation=https://github.com/aicore/aicore
After=network.target
Wants=network-online.target

[Service]
Type=simple
# Specialized non-privileged users
User=aicore
Group=aicore

# Executable documents and parameters
ExecStart=/usr/local/bin/aicored \
    --config /etc/aicore/config.json \
    --ipc-path /run/aicore/aicored.sock \
    --state-path /var/lib/aicore/status.json \
    --memory-path /var/lib/aicore/memory.db \
    --plugins-dir /usr/local/share/aicore/plugins \
    --log-format json

# An elegant exit.
KillSignal=SIGTERM
TimeoutStopSec=15

# Restart Policy
Restart=on-failure
RestartSec=5

# Status directory and running time directory
StateDirectory=aicore
RuntimeDirectory=aicore
StateDirectoryMode=0750
RuntimeDirectoryMode=0750

# Security enhancements
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=false
ReadWritePaths=/var/lib/aicore /run/aicore

# Resource constraints
LimitNOFILE=65536
# Memory/Tasks limits are deployment-specific; configure with a systemd drop-in.

[Install]
WantedBy=multi-user.target
